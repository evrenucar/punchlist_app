# Stray/experimental app copies not produced by the build
website/punchlist/

# The development interface's board pane, re-pinned by every build from the
# same output. A generated duplicate of website/task-board.html, never edited.
status/board.html

# Exported board backups (personal task data must never be committed)
*.punchlist.json
*-backup.json
*-board-export.json

# OS cruft
Thumbs.db
Desktop.ini
.DS_Store

# Editor cruft
*.swp
.vscode/
.idea/

# Browser tooling debris
.playwright-mcp/
*.stackdump

# Status-board chat log (conversation data, not project state)
status/chat.jsonl

# Status-board user prefs (notifications, auto mode)
status/prefs.json

# Live context numbers from the statusline hook (session data, not project state)
status/ctx.json

# Agent phase log behind /progress (session data, appended by the server)
status/phases.jsonl
